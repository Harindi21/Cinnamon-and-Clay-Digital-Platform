{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinnamon-and-clay.example/schemas/release-manifest.schema.json",
  "title": "Cinnamon & Clay immutable release manifest",
  "type": "object",
  "required": ["schemaVersion", "releaseVersion", "source", "images", "generatedAt"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "releaseVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "type": "object",
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "required": ["backend", "publicWeb"],
      "properties": {
        "backend": {"$ref": "#/$defs/backendImage"},
        "publicWeb": {"$ref": "#/$defs/publicWebImage"}
      },
      "additionalProperties": false
    },
    "generatedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "backendImage": {
      "type": "object",
      "required": ["ref", "digest", "sbom"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^ghcr\\.io/[a-z0-9_.-]+/cinnamon-clay-backend$"
        },
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sbom": {"const": "backend.cdx.json"}
      },
      "additionalProperties": false
    },
    "publicWebImage": {
      "type": "object",
      "required": ["ref", "digest", "sbom"],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^ghcr\\.io/[a-z0-9_.-]+/cinnamon-clay-public-web$"
        },
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sbom": {"const": "public-web.cdx.json"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
