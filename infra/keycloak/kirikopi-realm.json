{
  "realm": "kirikopi",
  "enabled": true,
  "displayName": "Kirikopi",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "roles": {
    "client": {
      "kirikopi-api": [
        {
          "name": "editor",
          "description": "Manage cafe content and operational data",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "admin",
          "description": "Full Kirikopi administration access",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "kirikopi-api",
      "name": "Kirikopi API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "kirikopi-admin-mobile",
      "name": "Kirikopi Admin Mobile",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "dev.kirikopi.admin:/oauthredirect"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "dev.kirikopi.admin:/oauthredirect"
      },
      "protocolMappers": [
        {
          "name": "kirikopi-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "kirikopi-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "users": [
    {
      "username": "local.admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Admin",
      "email": "local.admin@kirikopi.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "kirikopi-api": [
          "admin"
        ]
      }
    },
    {
      "username": "local.editor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Local",
      "lastName": "Editor",
      "email": "local.editor@kirikopi.test",
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEMO_EDITOR_PASSWORD}",
          "temporary": false
        }
      ],
      "clientRoles": {
        "kirikopi-api": [
          "editor"
        ]
      }
    }
  ]
}