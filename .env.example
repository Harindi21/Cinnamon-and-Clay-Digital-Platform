# Local development defaults intentionally avoid common machine-level 5432/8080 conflicts.
POSTGRES_DB=cinnamon_clay
POSTGRES_USER=cinnamon_clay
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=55432

BACKEND_PORT=8082
PUBLIC_WEB_PORT=3000

MINIO_ROOT_USER=cinnamon_clay
MINIO_ROOT_PASSWORD=change-me-locally
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

MEDIA_S3_ENDPOINT=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=cafe-media
MEDIA_S3_ACCESS_KEY=cinnamon_clay
MEDIA_S3_SECRET_KEY=change-me-locally

KEYCLOAK_PORT=8081
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me-locally

KEYCLOAK_DEMO_ADMIN_PASSWORD=change-me-locally
KEYCLOAK_DEMO_EDITOR_PASSWORD=change-me-locally

OIDC_ISSUER_URI=http://localhost:8081/realms/cinnamon-clay
OIDC_AUDIENCE=cinnamon-clay-api
OIDC_RESOURCE_CLIENT_ID=cinnamon-clay-api

# Public Next.js cache invalidation. Use a stronger per-environment secret outside local dev.
PUBLIC_REVALIDATION_ENABLED=true
PUBLIC_REVALIDATION_URL=http://localhost:3000/api/internal/revalidate
PUBLIC_REVALIDATION_SECRET=change-me-locally
PUBLIC_REVALIDATION_TIMEOUT=PT1S

# Runtime identity used by structured production logs/container profile.
APP_ENVIRONMENT=local-container

# Observability. Prometheus is the local default; OTLP exports stay opt-in.
TRACING_SAMPLING_PROBABILITY=1.0
OTLP_TRACING_ENABLED=false
OTLP_METRICS_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-locally

# Media upload safety limits (Spring Boot defaults match these values)
MEDIA_MULTIPART_MAX_FILE_SIZE=8MB
MEDIA_MULTIPART_MAX_REQUEST_SIZE=9MB
MEDIA_UPLOAD_MAX_BYTES=8388608
MEDIA_UPLOAD_MAX_WIDTH=6000
MEDIA_UPLOAD_MAX_HEIGHT=6000
MEDIA_UPLOAD_MAX_PIXELS=24000000
MEDIA_ORPHAN_GRACE_PERIOD=PT1H
